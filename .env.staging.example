# ==============================================================================
# PAWND Frontend - Staging Environment (.env.staging)
# สำหรับตั้งค่าใน Vercel Environment Variables: "Preview" (Branch: dev)
# ==============================================================================

# Backend API URL (ใส่ URL ของ Railway Staging Backend)
API_URL="https://pawnd-be-staging.up.railway.app"
NEXT_PUBLIC_API_URL="https://pawnd-be-staging.up.railway.app"
NEXT_PUBLIC_PAWND_API_URL="https://pawnd-be-staging.up.railway.app"

# Realtime WebSocket URL
NEXT_PUBLIC_SOCKET_URL="https://pawnd-be-staging.up.railway.app"

# NextAuth / Auth Session Secret (สุ่มสตริงความยาว 32 ตัวอักษรขึ้นไป)
AUTH_SECRET="pawnd-staging-auth-secret-32-chars-long"

# Social Authentication Client IDs (สำหรับแสดงปุ่ม Login ในหน้าเว็บ)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
NEXT_PUBLIC_LINE_CHANNEL_ID="your_line_channel_id"
