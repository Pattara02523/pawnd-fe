# ==============================================================================
# PAWND Frontend - Production Environment (.env.production)
# สำหรับตั้งค่าใน Vercel Environment Variables: "Production" (Branch: main)
# ==============================================================================

# Backend API URL (ใส่ URL ของ Railway Production Backend)
API_URL="https://pawnd-be-production.up.railway.app"
NEXT_PUBLIC_API_URL="https://pawnd-be-production.up.railway.app"
NEXT_PUBLIC_PAWND_API_URL="https://pawnd-be-production.up.railway.app"

# Realtime WebSocket URL
NEXT_PUBLIC_SOCKET_URL="https://pawnd-be-production.up.railway.app"

# NextAuth / Auth Session Secret (ต้องสุ่มใหม่ ไม่ใช้ซ้ำกับ Staging)
AUTH_SECRET="pawnd-production-auth-super-secret-key-32-chars-long"

# Social Authentication Client IDs (สำหรับ Production)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
NEXT_PUBLIC_LINE_CHANNEL_ID="your_line_channel_id"
